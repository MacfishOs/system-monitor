<RCC>
    <qresource prefix="/qml">
        <file alias="Main.qml">qml/Main.qml</file>
        <file alias="ResourceSummary.qml">qml/ResourceSummary.qml</file>
        <file alias="ProcessesPage.qml">qml/ProcessesPage.qml</file>
        <file alias="ColumnHeader.qml">qml/ColumnHeader.qml</file>
        <file alias="ResourcePage.qml">qml/ResourcePage.qml</file>
        <file alias="ChartCard.qml">qml/ChartCard.qml</file>
        <file alias="DetailRow.qml">qml/DetailRow.qml</file>
        <file alias="ProcessDetails.qml">qml/ProcessDetails.qml</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="cpu.svg">icons/cpu.svg</file>
        <file alias="memory.svg">icons/memory.svg</file>
        <file alias="network.svg">icons/network.svg</file>
        <file alias="disk.svg">icons/disk.svg</file>
        <file alias="gpu.svg">icons/gpu.svg</file>
    </qresource>
</RCC>
